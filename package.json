{
  "name": "power-platform-playwright-samples",
  "version": "0.0.4",
  "private": true,
  "author": "Microsoft",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/power-platform-playwright-samples.git"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:toolkit": "npm run build --workspace power-platform-playwright-toolkit",
    "build:e2e": "npm run build --workspace @power-platform-playwright/e2e-tests",
    "lint": "npm run lint --workspaces --if-present",
    "prettier": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "rebuild": "npm run clean --workspaces --if-present && npm run build",
    "update": "npm update --workspaces"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}
